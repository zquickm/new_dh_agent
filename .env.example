# Selects config/application-{profile}.yaml.
APP_PROFILE=dev

# Optional for model services that require authentication.
NEW_DH_LLM__API_KEY=

# Sensitive values referenced by ${ENV_NAME:default} in application.yaml.
RAG_API_TOKEN=
BUSINESS_DB_PASSWORD=
SPATIAL_API_KEY= DMZY_SPATIAL_API_KEY_001

# Optional: only needed when SQL generation uses a separate authenticated model.
DEEPSEEK_API_KEY=

# 独立敏感词库：完成迁移后将 csv 改为 mysql；不复用 Doris 业务连接。
NEW_DH_SENSITIVE_WORDS__BACKEND=csv
NEW_DH_SENSITIVE_WORDS__MYSQL__HOST=127.0.0.1
NEW_DH_SENSITIVE_WORDS__MYSQL__PORT=3306
NEW_DH_SENSITIVE_WORDS__MYSQL__USER=sensitive_word_user
NEW_DH_SENSITIVE_WORDS__MYSQL__PASSWORD=
NEW_DH_SENSITIVE_WORDS__MYSQL__DATABASE=new_dh_agent
NEW_DH_SENSITIVE_WORDS__REDIS__URL=redis://127.0.0.1:6379/0
NEW_DH_SENSITIVE_WORDS__ADMIN_TOKEN=
# 以下仅供一次性导出脚本使用，需导出到进程环境，不能填写 Git 仓库 URL。
SOURCE_SENSITIVE_BASE_URL=
SOURCE_SENSITIVE_TOKEN=
