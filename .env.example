# Selects config/application-{profile}.yaml.
APP_PROFILE=dev

# Optional for model services that require authentication.
NEW_DH_LLM__API_KEY=

# Internal RAG recall. RAG_RECALL_URL can replace BASE_URL + RECALL_PATH.
RAG_BASE_URL=http://your-rag-host
RAG_RECALL_PATH=/rag-platform-default/zsgl/knowledgeRecall
RAG_API_TOKEN=
RAG_TENANT_ID=
RAG_KNOWLEDGE_IDS=knowledge-id-1
RAG_DEPT_IDS=department-id-1
RAG_SCORE=0.6
RAG_TIMEOUT=30
RAG_CONNECT_TIMEOUT=5
RAG_VERIFY_SSL=true
RAG_MAX_RETRIES=2
RAG_RETRY_BACKOFF=0.5

# Optional vLLM reranker.
RERANK_ENABLED=true
RERANK_BASE_URL=http://your-rerank-host
RERANK_PATH=/v1/rerank
RERANK_MODEL=Qwen3-Reranker-4B
RERANK_CANDIDATE_TOP_N=100
RERANK_TIMEOUT=15

# Optional model override used only for natural-language-to-SQL generation.
# When omitted, the database tool reuses NEW_DH_LLM__* above.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TEMPERATURE=0
DATABASE_SQL_LLM_TIMEOUT=120

# Trusted query guide and authorized table DDL files.
# Defaults to this project's database_information directory.
DATABASE_QUERY_GUIDE_FILE=断面数据_AI_SQL查询指南.md

# Dedicated read-only MySQL account. Grant SELECT only.
BUSINESS_DB_HOST=127.0.0.1
BUSINESS_DB_PORT=3306
BUSINESS_DB_USER=readonly_user
BUSINESS_DB_PASSWORD=
BUSINESS_DB_NAME=document
BUSINESS_DB_CONNECT_TIMEOUT=5
BUSINESS_DB_QUERY_TIMEOUT=10
BUSINESS_DB_MAX_ROWS=1000
BUSINESS_DB_POOL_MAX_SIZE=3
BUSINESS_DB_SSL_ENABLED=false
BUSINESS_DB_SSL_CA=
BUSINESS_DB_SSL_VERIFY_CERT=true
