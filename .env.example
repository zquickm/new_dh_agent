# Selects config/application-{profile}.yaml.
APP_PROFILE=dev

# Internal service, bind, and required MySQL persistence settings.
DH_INTERNAL_TOKEN=
DH_AGENT_BIND_HOST=0.0.0.0
DH_AGENT_PORT=8000
DH_AGENT_DB_HOST=127.0.0.1
DH_AGENT_DB_PORT=3306
DH_AGENT_DB_NAME=dh_agent
DH_AGENT_DB_USERNAME=new_dh_agent
DH_AGENT_DB_PASSWORD=
DH_KNOWLEDGE_HOST=127.0.0.1
DH_KNOWLEDGE_PORT=8082

# Production-only service addresses.
DH_LLM_HOST=71.10.60.31
DH_LLM_PORT=8900
DH_SQL_LLM_HOST=71.10.60.31
DH_SQL_LLM_PORT=8900
DH_RAG_HOST=71.10.60.34
DH_RAG_PORT=18000
DH_RAG_RERANK_HOST=71.10.60.34
DH_RAG_RERANK_PORT=18000
DH_SPATIAL_HOST=71.10.60.143
DH_SPATIAL_PORT=6022
DH_BUSINESS_DB_HOST=71.10.60.155
DH_BUSINESS_DB_PORT=9030
DH_BUSINESS_DB_USERNAME=dh_agent_reader

# Optional for model services that require authentication.
NEW_DH_LLM__API_KEY=
# Optional overrides; defaults are 128K window, 8K output reserve and 2K safety margin.
NEW_DH_LLM__CONTEXT_WINDOW_TOKENS=131072
NEW_DH_LLM__MAX_OUTPUT_TOKENS=8192
NEW_DH_LLM__TOKEN_SAFETY_MARGIN=2048
NEW_DH_LLM__REASONING_EFFORT=none

# Sensitive values referenced by ${ENV_NAME:default} in application.yaml.
RAG_API_TOKEN=
# 通用和厦门场景共用上面的服务 key，以下为请求体 knowledge_ids 中的库 ID
RAG_POLICY_KNOWLEDGE_ID=KLB_6f3b2a4e0182429fad6edfc91ebc0854
RAG_BUSINESS_KNOWLEDGE_ID=KLB_14a237908da04979b7f0154c15689f46
RAG_LITERATURE_KNOWLEDGE_ID=KLB_f0a1998795cf4b0c90b87b180da88162
# 同义词扩展后命中“厦门”“疑点疑区”或“图斑”，使用包含此库的厦门四库场景
RAG_XIAMEN_KNOWLEDGE_ID=KLB_bc6985d4abfb4e79b80e5e7b1e0926a3
BUSINESS_DB_PASSWORD=
SPATIAL_API_KEY=DMZY_SPATIAL_API_KEY_001

# Optional: only needed when SQL generation uses a separate authenticated model.
DEEPSEEK_API_KEY=

# 模型流诊断（当前 application.yaml 开启；定位后设 false）
NEW_DH_LLM__DIAGNOSTICS_ENABLED=true
NEW_DH_LLM__DIAGNOSTICS_MAX_CHARS=16384
NEW_DH_LLM__DIAGNOSTICS_MAX_EVENTS=100

# 固定 QA 思考展示（仅影响命中后的回放，单条 QA 的配置优先）
# 固定 QA 匹配模式：model（全部已发布候选交给模型）或 exact（原精确匹配）
NEW_DH_EXACT_QA__MATCH_MODE=model
NEW_DH_EXACT_QA__MATCH_TIMEOUT=30
NEW_DH_EXACT_QA__THINKING_TITLE="第 {round_number} 轮思考"
# NEW_DH_EXACT_QA__THINKING_SUMMARY=正在查询QA库
NEW_DH_EXACT_QA__THINKING_MIN_DURATION_MS=2000
NEW_DH_EXACT_QA__THINKING_MAX_DURATION_MS=5000
